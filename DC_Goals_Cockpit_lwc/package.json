{
  "name": "dc-goals-cockpit-lwc",
  "private": true,
  "version": "1.0.0",
  "description": "FSC Journey Cockpit LWC for record pages: KPIs + journey rail + adaptive panel (Goals or Opportunities).",
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "@babel/core": "^7.29.6",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    },
    "js-yaml": "^4.3.2",
    "@vitest/mocker": "^4.1.11",
    "vitest": "^4.1.11",
    "axios": "^1.18.0",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
    "joi": "^18.2.5",
    "postcss": "^8.5.23",
    "brace-expansion": "^1.1.18",
    "@lwc/eslint-plugin-lwc": {
      "minimatch": {
        "brace-expansion": "^2.1.4"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "^5.0.9"
      }
    }
  },
  "scripts": {
    "lint": "eslint \"force-app/**/lwc/**/*.js\"",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "prettier": "prettier --write \"**/*.{cls,css,html,js,json,md,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,css,html,js,json,md,trigger,xml,yaml,yml}\""
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  }
}
