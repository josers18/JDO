          "location": "{!$attrs.outputValues.account.location}",
          "openOpportunities": "{!$attrs.outputValues.account.openOpportunities}",
          "openPipeline": "{!$attrs.outputValues.account.openPipeline}",
          "recordUrl": "{!$attrs.outputValues.account.recordUrl}"
