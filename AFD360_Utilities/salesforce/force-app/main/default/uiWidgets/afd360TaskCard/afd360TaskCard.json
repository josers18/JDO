{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/container",
          "attributes": {
            "variant": "default"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md",
                "align": "stretch"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "start",
                    "isWrapped": false
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "alt": "Task",
                        "name": "list-checks",
                        "size": "sm",
                        "color": "primary"
                      }
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "none",
                        "align": "start",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.subject}",
                            "variant": "h4",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.message}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.status} \u00b7 Priority: {!$attrs.priority}",
                    "variant": "caption",
                    "weight": "semibold"
                  },
                  "meta": {
                    "if": "{!$attrs.created}"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Due \u00b7 {!$attrs.dueDate}",
                    "variant": "body",
                    "weight": "semibold"
                  },
                  "meta": {
                    "if": "{!$attrs.created}"
                  }
                },
                {
                  "definition": "tile/accordion",
                  "children": [
                    {
                      "definition": "tile/accordionItem",
                      "attributes": {
                        "title": "Assignment details",
                        "isExpanded": false
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "sm",
                            "align": "stretch"
                          },
                          "children": [
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs",
                                "align": "start",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Related to",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.relatedTo}",
                                    "variant": "body",
                                    "weight": "medium"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs",
                                "align": "start",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Contact or lead",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.name}",
                                    "variant": "body",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Assigned to",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.assignedTo}",
                                    "variant": "body",
                                    "weight": "medium"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.created}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Review completion",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "Show me task ID {!$attrs.taskId} and ask me to confirm before marking it complete."
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "href": "{!$attrs.recordUrl}",
                        "text": "Open task",
                        "underline": "always"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.created}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
