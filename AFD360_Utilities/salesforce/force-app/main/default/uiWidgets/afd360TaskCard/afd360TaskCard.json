{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md",
            "align": "stretch"
          },
          "children": [
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.subject}",
                    "variant": "h2"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.message}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.status}",
                    "variant": "info"
                  }
                },
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.priority}",
                    "variant": "warning"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.created}"
              }
            },
            {
              "definition": "tile/container",
              "attributes": {
                "variant": "emphasis"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Due",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.dueDate}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Related to",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.relatedTo}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Name",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.name}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Assigned to",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.assignedTo}",
                            "variant": "body"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "meta": {
                "if": "{!$attrs.created}"
              }
            },
            {
              "definition": "tile/button",
              "attributes": {
                "label": "Mark complete",
                "variant": "secondary",
                "actions": {
                  "click": [
                    {
                      "definition": "action/sendMessage",
                      "attributes": {
                        "content": "Mark the task \"{!$attrs.subject}\" ({!$attrs.taskId}) as Completed"
                      }
                    }
                  ]
                }
              },
              "meta": {
                "if": "{!$attrs.created}"
              }
            },
            {
              "definition": "tile/link",
              "attributes": {
                "href": "{!$attrs.recordUrl}",
                "text": "Open in Salesforce"
              },
              "meta": {
                "if": "{!$attrs.created}"
              }
            }
          ]
        }
      ]
    }
  }
}