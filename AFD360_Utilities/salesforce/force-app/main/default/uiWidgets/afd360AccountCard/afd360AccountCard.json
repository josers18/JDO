{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/container",
          "attributes": {
            "variant": "default"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md",
                "align": "stretch"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "start",
                    "isWrapped": false
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "alt": "Account",
                        "name": "building",
                        "size": "sm",
                        "color": "primary"
                      }
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "none",
                        "align": "start",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.name}",
                            "variant": "h4",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.accountType} \u00b7 {!$attrs.industry} \u00b7 {!$attrs.location}",
                            "variant": "caption",
                            "color": "muted"
                          },
                          "meta": {
                            "if": "{!$attrs.found}"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "none",
                    "align": "start",
                    "width": "auto"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Open pipeline",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.openPipeline}",
                        "variant": "h3",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.openOpportunities}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                },
                {
                  "definition": "tile/accordion",
                  "children": [
                    {
                      "definition": "tile/accordionItem",
                      "attributes": {
                        "title": "Relationship details",
                        "isExpanded": false
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "sm",
                            "align": "stretch"
                          },
                          "children": [
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "none",
                                "align": "start",
                                "width": "auto"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Owner",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.owner}",
                                    "variant": "body",
                                    "weight": "semibold"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs",
                                "align": "start",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Phone",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.phone}",
                                    "variant": "body",
                                    "weight": "medium"
                                  }
                                }
                              ]
                            },
                            {
                              "definition": "tile/column",
                              "attributes": {
                                "gap": "xs",
                                "align": "start",
                                "width": "stretch"
                              },
                              "children": [
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "Website",
                                    "variant": "caption",
                                    "color": "muted",
                                    "weight": "medium"
                                  }
                                },
                                {
                                  "definition": "tile/text",
                                  "attributes": {
                                    "text": "{!$attrs.website}",
                                    "variant": "body",
                                    "weight": "medium"
                                  }
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Largest open deal",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "Show the largest open opportunity for account ID {!$attrs.accountId}."
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "href": "{!$attrs.recordUrl}",
                        "text": "Open account",
                        "underline": "always"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
