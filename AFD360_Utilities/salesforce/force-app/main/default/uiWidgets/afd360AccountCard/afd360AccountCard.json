{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md",
            "align": "stretch"
          },
          "children": [
            {
              "definition": "tile/container",
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.name}",
                    "variant": "h2"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.location}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "\u2022",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.owner}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm"
              },
              "children": [
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.accountType}",
                    "variant": "info"
                  }
                },
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.industry}",
                    "variant": "secondary"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.found}"
              }
            },
            {
              "definition": "tile/container",
              "attributes": {
                "variant": "emphasis"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm",
                    "align": "start"
                  },
                  "children": [
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Open pipeline",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.openPipeline}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Opportunities",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.openOpportunities}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Phone",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.phone}",
                            "variant": "body"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "Website",
                            "variant": "body",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.website}",
                            "variant": "body"
                          }
                        }
                      ]
                    }
                  ]
                }
              ],
              "meta": {
                "if": "{!$attrs.found}"
              }
            },
            {
              "definition": "tile/link",
              "attributes": {
                "href": "{!$attrs.recordUrl}",
                "text": "Open in Salesforce"
              },
              "meta": {
                "if": "{!$attrs.found}"
              }
            }
          ]
        }
      ]
    }
  }
}