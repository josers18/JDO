{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/container",
          "attributes": {
            "variant": "default"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "md",
                "align": "stretch"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "start",
                    "isWrapped": false
                  },
                  "children": [
                    {
                      "definition": "tile/icon",
                      "attributes": {
                        "alt": "Lead",
                        "name": "user",
                        "size": "sm",
                        "color": "primary"
                      }
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "none",
                        "align": "start",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.name}",
                            "variant": "h4",
                            "weight": "semibold"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$attrs.title} \u00b7 {!$attrs.company}",
                            "variant": "caption",
                            "color": "muted"
                          },
                          "meta": {
                            "if": "{!$attrs.found}"
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.status} \u00b7 Rating: {!$attrs.rating}",
                    "variant": "caption",
                    "weight": "semibold"
                  },
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "xs",
                    "align": "start",
                    "width": "stretch"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Email",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.email}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Phone",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.phone}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                },
                {
                  "definition": "tile/accordion",
                  "children": [
                    {
                      "definition": "tile/accordionItem",
                      "attributes": {
                        "title": "Lead history",
                        "isExpanded": false
                      },
                      "children": [
                        {
                          "definition": "tile/column",
                          "attributes": {
                            "gap": "xs",
                            "align": "start",
                            "width": "stretch"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Lead source",
                                "variant": "caption",
                                "color": "muted",
                                "weight": "medium"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.leadSource}",
                                "variant": "body",
                                "weight": "medium"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "Created",
                                "variant": "caption",
                                "color": "muted",
                                "weight": "medium"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$attrs.createdDate}",
                                "variant": "body",
                                "weight": "medium"
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                },
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "sm",
                    "align": "center",
                    "isWrapped": true
                  },
                  "children": [
                    {
                      "definition": "tile/button",
                      "attributes": {
                        "label": "Plan outreach",
                        "variant": "secondary",
                        "actions": {
                          "click": [
                            {
                              "definition": "action/sendMessage",
                              "attributes": {
                                "content": "Help me plan a follow-up task for the lead at {!$attrs.recordUrl}. Ask me for the subject and due date before creating it."
                              }
                            }
                          ]
                        }
                      }
                    },
                    {
                      "definition": "tile/link",
                      "attributes": {
                        "href": "{!$attrs.recordUrl}",
                        "text": "Open lead",
                        "underline": "always"
                      }
                    }
                  ],
                  "meta": {
                    "if": "{!$attrs.found}"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
