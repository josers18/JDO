{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md",
            "align": "stretch"
          },
          "children": [
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "md",
                "align": "start",
                "isWrapped": false
              },
              "children": [
                {
                  "definition": "tile/avatar",
                  "attributes": {
                    "iconName": "user",
                    "shape": "rounded",
                    "size": "lg",
                    "alt": "record"
                  }
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "none",
                    "align": "start",
                    "width": "stretch"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.name}",
                        "variant": "h3",
                        "weight": "semibold"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.title} \u00b7 {!$attrs.company}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "sm",
                "align": "center"
              },
              "children": [
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.status}",
                    "variant": "info"
                  }
                },
                {
                  "definition": "tile/badge",
                  "attributes": {
                    "label": "{!$attrs.rating}",
                    "variant": "warning"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.found}"
              }
            },
            {
              "definition": "tile/separator",
              "meta": {
                "if": "{!$attrs.found}"
              }
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "lg",
                "align": "start"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "xs",
                    "align": "start",
                    "width": "stretch"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Email",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.email}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Phone",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.phone}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    }
                  ]
                },
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "xs",
                    "align": "start",
                    "width": "stretch"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Lead source",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.leadSource}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "Created",
                        "variant": "caption",
                        "color": "muted",
                        "weight": "medium"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$attrs.createdDate}",
                        "variant": "body",
                        "weight": "medium"
                      }
                    }
                  ]
                }
              ],
              "meta": {
                "if": "{!$attrs.found}"
              }
            },
            {
              "definition": "tile/row",
              "attributes": {
                "gap": "md",
                "align": "center"
              },
              "children": [
                {
                  "definition": "tile/button",
                  "attributes": {
                    "label": "Create follow-up task",
                    "variant": "secondary",
                    "iconName": "list-checks",
                    "actions": {
                      "click": [
                        {
                          "definition": "action/sendMessage",
                          "attributes": {
                            "content": "Create a follow-up task for the lead {!$attrs.name} ({!$attrs.company})"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "definition": "tile/link",
                  "attributes": {
                    "href": "{!$attrs.recordUrl}",
                    "text": "Open in Salesforce"
                  }
                }
              ],
              "meta": {
                "if": "{!$attrs.found}"
              }
            }
          ]
        }
      ]
    }
  }
}