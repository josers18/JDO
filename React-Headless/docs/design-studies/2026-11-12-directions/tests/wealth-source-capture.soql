-- crm_financialAccounts; captured 2026-11-13; returned 79; available
SELECT Id,Name,FinServ__PrimaryOwner__c,FinServ__Balance__c,FinServ__FinancialAccountType__c,FinServ__Status__c FROM FinServ__FinancialAccount__c WHERE FinServ__PrimaryOwner__r.OwnerId='005am000003PbCLAA0' ORDER BY FinServ__Balance__c DESC LIMIT 201;

-- crm_goals; captured 2026-11-13; returned 4; available
SELECT Id,Name,Type,Status,Priority,Description,TargetDate,TargetAmount,ActualAmount,FinancialPlanId,FinancialPlan.AccountId FROM FinancialGoal WHERE FinancialPlan.AccountId IN ('001am00000qvjsAAAQ','001am000026ZtgKAAS') LIMIT 50;

-- crm_leads; captured 2026-11-13; returned 30; available
SELECT Id,FirstName,LastName,Name,Company,Status,LeadSource,Email,AnnualRevenue,OwnerId FROM Lead WHERE OwnerId='005am000003PbCLAA0' AND IsConverted=false LIMIT 30;

-- crm_opportunities; captured 2026-11-13; returned 201; available
SELECT Id,Name,AccountId,Amount,StageName,IsClosed,IsWon,CloseDate,LeadSource,OwnerId FROM Opportunity WHERE OwnerId='005am000003PbCLAA0' ORDER BY Amount DESC LIMIT 201;

-- crm_tasks; captured 2026-11-13; returned 30; available
SELECT Id,Subject,Status,Priority,ActivityDate,WhoId,WhatId,OwnerId,Description FROM Task WHERE OwnerId='005am000003PbCLAA0' ORDER BY ActivityDate DESC NULLS LAST LIMIT 30;

-- crm_events; captured 2026-11-13; returned 20; available
SELECT Id,Subject,StartDateTime,EndDateTime,DurationInMinutes,WhoId,WhatId,OwnerId,Description,Location,ShowAs FROM Event WHERE OwnerId='005am000003PbCLAA0' ORDER BY StartDateTime DESC LIMIT 20;

-- crm_deepAccounts; captured 2026-11-13; returned 2; available
SELECT Id,Name,OwnerId,PersonEmail,PersonContactId FROM Account WHERE Id IN ('001am00000qvjsAAAQ','001am000026ZtgKAAS');

-- crm_pipelineStages; captured 2026-11-13; returned 25; available
SELECT StageName,COUNT(Id) n,SUM(Amount) amount FROM Opportunity WHERE OwnerId='005am000003PbCLAA0' AND IsClosed=false GROUP BY StageName;

-- crm_gridOpen; captured 2026-11-13; returned 1; available
SELECT COUNT(Id) n,SUM(Amount) amount FROM Opportunity WHERE OwnerId='005am000003PbCLAA0' AND LeadSource='Cross-sell grid' AND IsClosed=false;

-- crm_gridWon; captured 2026-11-13; returned 1; available
SELECT COUNT(Id) n FROM Opportunity WHERE OwnerId='005am000003PbCLAA0' AND LeadSource='Cross-sell grid' AND IsWon=true AND CloseDate=LAST_N_DAYS:30;

-- crm_deepCases; captured 2026-11-13; returned 25; available
SELECT Id,CaseNumber,Subject,Status,Priority,AccountId,OwnerId,CreatedDate FROM Case WHERE AccountId IN ('001am00000qvjsAAAQ','001am000026ZtgKAAS') ORDER BY CreatedDate DESC LIMIT 25;

