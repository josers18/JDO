-- opportunities
SELECT Id,Name,AccountId,Account.Name,OwnerId,Amount,Probability,StageName,CloseDate,LeadSource,Description FROM Opportunity WHERE OwnerId='005am000003PbFDAA0' AND IsClosed=false ORDER BY Amount DESC LIMIT 100;

-- tasks
SELECT Id,Subject,AccountId,WhatId,WhoId,OwnerId,ActivityDate,Status,Priority,Description FROM Task WHERE OwnerId='005am000003PbFDAA0' ORDER BY ActivityDate DESC LIMIT 30;

-- events
SELECT Id,Subject,AccountId,WhatId,WhoId,OwnerId,StartDateTime,EndDateTime,Location,Description FROM Event WHERE OwnerId='005am000003PbFDAA0' ORDER BY StartDateTime DESC LIMIT 30;

-- cases
SELECT Id,CaseNumber,AccountId,Account.Name,OwnerId,Subject,Status,Priority,Origin,Description,CreatedDate FROM Case WHERE Account.OwnerId='005am000003PbFDAA0' ORDER BY CreatedDate DESC LIMIT 30;

-- leads
SELECT Id,FirstName,LastName,Name,Company,OwnerId,Status,LeadSource,Email,Phone,AnnualRevenue,Industry,Description FROM Lead WHERE OwnerId='005am000003PbFDAA0' AND IsConverted=false ORDER BY LastModifiedDate DESC LIMIT 30;

-- holders
SELECT Id,Name,FinServ__PrimaryOwner__c,FinServ__Balance__c,FinServ__Status__c FROM FinServ__FinancialAccount__c WHERE Name LIKE '%Corporate Card%' AND FinServ__Status__c!='Closed' AND FinServ__PrimaryOwner__r.OwnerId='005am000003PbFDAA0' ORDER BY FinServ__Balance__c DESC LIMIT 3;

-- openStats
SELECT COUNT(Id) n,SUM(Amount) amount FROM Opportunity WHERE OwnerId='005am000003PbFDAA0' AND LeadSource='Cross-sell grid' AND IsClosed=false;

-- wonStats
SELECT COUNT(Id) n FROM Opportunity WHERE OwnerId='005am000003PbFDAA0' AND LeadSource='Cross-sell grid' AND IsWon=true AND CloseDate>=2026-10-14;

