-- companyTasks
SELECT Id,Subject,AccountId,WhatId,WhoId,OwnerId,ActivityDate,Status,Priority,Description FROM Task WHERE AccountId IN ('001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') ORDER BY ActivityDate DESC LIMIT 50;

-- companyEvents
SELECT Id,Subject,AccountId,WhatId,WhoId,OwnerId,StartDateTime,EndDateTime,Location,Description FROM Event WHERE AccountId IN ('001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') ORDER BY StartDateTime DESC LIMIT 30;

-- companyCases
SELECT Id,CaseNumber,AccountId,OwnerId,Subject,Status,Priority,Origin,Description,CreatedDate FROM Case WHERE AccountId IN ('001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') ORDER BY CreatedDate DESC LIMIT 30;

-- companyGoals
SELECT Id,Name,Type,Priority,Description,TargetDate,TargetValue,ActualValue,FinancialPlanId,FinancialPlan.AccountId FROM FinancialGoal WHERE FinancialPlan.AccountId IN ('001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') LIMIT 30;

-- holdings
SELECT Id,Name,FinServ__PrimaryOwner__c,FinServ__Balance__c,FinServ__Status__c,FinServ__FinancialAccountType__c,FinServ__OpenDate__c FROM FinServ__FinancialAccount__c WHERE FinServ__PrimaryOwner__c IN ('001am00002AAB59AAH','001am00002AAB6BAAX','001am00002A9jrrAAB','001am00002A9jt0AAB','001am00002A9c6GAAR','001am00002AAB68AAH','001am00002AAB6HAAX','001am00002AAB6FAAX','001am00002A9jrzAAB','001am00002A9jm3AAB','001am00002AYRl8AAH','001am00002A9jr0AAB','001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') LIMIT 300;

-- pipelineStats
SELECT COUNT(Id) n,SUM(Amount) amount FROM Opportunity WHERE OwnerId='005am000003PbFDAA0' AND IsClosed=false;

-- goalsCorrected
SELECT Id,Name,Type,Priority,Status,Description,TargetDate,TargetAmount,ActualAmount,FinancialPlanId,FinancialPlan.AccountId FROM FinancialGoal WHERE FinancialPlan.AccountId IN ('001am00002AAAvtAAH','001am00002AYRm2AAH','001am00002AYRUaAAP') LIMIT 30;
